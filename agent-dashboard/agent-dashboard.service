[Unit]
Description=OpenClaw Agent Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/agent-dashboard
ExecStart=/root/.nvm/versions/node/v22.22.1/bin/node server.js
Restart=always
RestartSec=5
Environment=PORT=9120
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
