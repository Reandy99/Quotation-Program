{
  "count": 31,
  "items": [
    {
      "n": 1,
      "scheduleId": "69e5cccb84ebdfba155e4fdd",
      "scheduleAtUTC": "2026-05-01T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-01 13:05 WIB",
      "charCount": 86,
      "text": "Banyak orang pikir dokumentasi event itu cuma buat arsip. Padahal, itu aset marketing."
    },
    {
      "n": 2,
      "scheduleId": "69e5cccb84ebdfba155e4fe5",
      "scheduleAtUTC": "2026-05-02T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-02 13:05 WIB",
      "charCount": 75,
      "text": "Kalau foto event kamu cuma ruangan kosong, trust yang kebangun juga kosong."
    },
    {
      "n": 3,
      "scheduleId": "69e5cccb84ebdfba155e4fe9",
      "scheduleAtUTC": "2026-05-03T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-03 13:05 WIB",
      "charCount": 72,
      "text": "Dokumentasi yang bagus itu bukan ‘banyak foto’. Tapi cerita yang kebaca."
    },
    {
      "n": 4,
      "scheduleId": "69e5cccc84ebdfba155e4fed",
      "scheduleAtUTC": "2026-05-04T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-04 13:05 WIB",
      "charCount": 81,
      "text": "Tips kecil: ambil 1 momen pembuka, 1 momen puncak, 1 momen penutup. Baru lengkap."
    },
    {
      "n": 5,
      "scheduleId": "69e5cccc84ebdfba155e4ff1",
      "scheduleAtUTC": "2026-05-05T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-05 13:05 WIB",
      "charCount": 79,
      "text": "Event selesai, tapi konten belum harus selesai. Materinya bisa dipakai 30 hari."
    },
    {
      "n": 6,
      "scheduleId": "69e5cccc84ebdfba155e4ff5",
      "scheduleAtUTC": "2026-05-06T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-06 13:05 WIB",
      "charCount": 85,
      "text": "Behind the scenes yang rapi bikin brand keliatan profesional tanpa perlu banyak kata."
    },
    {
      "n": 7,
      "scheduleId": "69e5cccd84ebdfba155e4ff9",
      "scheduleAtUTC": "2026-05-07T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-07 13:05 WIB",
      "charCount": 79,
      "text": "Audio, lighting, stage, crowd. Elemen ini yang bikin konten event terasa hidup."
    },
    {
      "n": 8,
      "scheduleId": "69e5cccd84ebdfba155e4fff",
      "scheduleAtUTC": "2026-05-08T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-08 13:05 WIB",
      "charCount": 88,
      "text": "Kalau mau konten premium, mulainya dari briefing yang jelas, bukan dari edit yang heboh."
    },
    {
      "n": 9,
      "scheduleId": "69e5cccd84ebdfba155e5003",
      "scheduleAtUTC": "2026-05-09T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-09 13:05 WIB",
      "charCount": 57,
      "text": "Satu frame yang kuat bisa mengalahkan 20 foto yang biasa."
    },
    {
      "n": 10,
      "scheduleId": "69e5cccd84ebdfba155e500a",
      "scheduleAtUTC": "2026-05-10T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-10 13:05 WIB",
      "charCount": 74,
      "text": "Yang bikin corporate event mahal bukan dekor. Tapi dampak dan persepsinya."
    },
    {
      "n": 11,
      "scheduleId": "69e5ccce84ebdfba155e500e",
      "scheduleAtUTC": "2026-05-11T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-11 13:05 WIB",
      "charCount": 81,
      "text": "Kamu mau audience inget acara kamu? Tangkap ekspresi mereka, bukan cuma backdrop."
    },
    {
      "n": 12,
      "scheduleId": "69e5ccce84ebdfba155e5012",
      "scheduleAtUTC": "2026-05-12T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-12 13:05 WIB",
      "charCount": 72,
      "text": "Bikin konten event itu harus mikir: ‘apa yang orang rasain waktu hadir?’"
    },
    {
      "n": 13,
      "scheduleId": "69e5ccce84ebdfba155e5018",
      "scheduleAtUTC": "2026-05-13T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-13 13:05 WIB",
      "charCount": 78,
      "text": "Dokumentasi itu bukti sosial. Kalau bukti sosialnya lemah, selling jadi berat."
    },
    {
      "n": 14,
      "scheduleId": "69e5cccf84ebdfba155e501c",
      "scheduleAtUTC": "2026-05-14T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-14 13:05 WIB",
      "charCount": 77,
      "text": "Cek cepat: foto kamu nunjukin ‘siapa’, ‘di mana’, dan ‘kenapa penting’ belum?"
    },
    {
      "n": 15,
      "scheduleId": "69e5cccf84ebdfba155e5021",
      "scheduleAtUTC": "2026-05-15T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-15 13:05 WIB",
      "charCount": 56,
      "text": "Brand kuat itu konsisten, termasuk di dokumentasi event."
    },
    {
      "n": 16,
      "scheduleId": "69e5cccf84ebdfba155e5027",
      "scheduleAtUTC": "2026-05-16T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-16 13:05 WIB",
      "charCount": 79,
      "text": "Kalau kamu mau tampil premium, jangan ragu pilih angle yang bersih dan minimal."
    },
    {
      "n": 17,
      "scheduleId": "69e5cccf84ebdfba155e502d",
      "scheduleAtUTC": "2026-05-17T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-17 13:05 WIB",
      "charCount": 80,
      "text": "Momen paling mahal kadang bukan di panggung, tapi di interaksi kecil setelahnya."
    },
    {
      "n": 18,
      "scheduleId": "69e5ccd084ebdfba155e5035",
      "scheduleAtUTC": "2026-05-18T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-18 13:05 WIB",
      "charCount": 84,
      "text": "Konten event yang bagus biasanya punya 3 layer: crowd, speaker, detail yang relevan."
    },
    {
      "n": 19,
      "scheduleId": "69e5ccd084ebdfba155e5039",
      "scheduleAtUTC": "2026-05-19T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-19 13:05 WIB",
      "charCount": 70,
      "text": "Kalau kamu hiring vendor dokumentasi, tanya: output akhirnya buat apa?"
    },
    {
      "n": 20,
      "scheduleId": "69e5ccd084ebdfba155e5040",
      "scheduleAtUTC": "2026-05-20T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-20 13:05 WIB",
      "charCount": 79,
      "text": "Konten yang bikin closing lebih gampang: highlight hasil, bukan sekadar proses."
    },
    {
      "n": 21,
      "scheduleId": "69e5ccd084ebdfba155e5045",
      "scheduleAtUTC": "2026-05-21T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-21 13:05 WIB",
      "charCount": 70,
      "text": "Kita sering bantu brand bikin dokumentasi yang siap jadi materi sales."
    },
    {
      "n": 22,
      "scheduleId": "69e5ccd184ebdfba155e5049",
      "scheduleAtUTC": "2026-05-22T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-22 13:05 WIB",
      "charCount": 76,
      "text": "Kalau kamu butuh tim yang ngerti event dan ngerti marketing, itu beda level."
    },
    {
      "n": 23,
      "scheduleId": "69e5ccd184ebdfba155e5061",
      "scheduleAtUTC": "2026-05-23T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-23 13:05 WIB",
      "charCount": 65,
      "text": "Mau konten yang bisa dipakai ulang? Ambil footage yang evergreen."
    },
    {
      "n": 24,
      "scheduleId": "69e5ccd184ebdfba155e5069",
      "scheduleAtUTC": "2026-05-24T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-24 13:05 WIB",
      "charCount": 66,
      "text": "Banyak yang over-edit. Padahal premium itu seringnya justru clean."
    },
    {
      "n": 25,
      "scheduleId": "69e5ccd284ebdfba155e506d",
      "scheduleAtUTC": "2026-05-25T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-25 13:05 WIB",
      "charCount": 72,
      "text": "Satu cara naikin trust: tunjukin skala acara lewat wide shot + reaction."
    },
    {
      "n": 26,
      "scheduleId": "69e5ccd284ebdfba155e5074",
      "scheduleAtUTC": "2026-05-26T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-26 13:05 WIB",
      "charCount": 82,
      "text": "Kalau dokumentasi kamu bisa bikin orang pengen hadir next event, berarti berhasil."
    },
    {
      "n": 27,
      "scheduleId": "69e5ccd284ebdfba155e5078",
      "scheduleAtUTC": "2026-05-27T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-27 13:05 WIB",
      "charCount": 57,
      "text": "BTS bukan cuma lucu-lucuan. BTS adalah bukti kamu serius."
    },
    {
      "n": 28,
      "scheduleId": "69e5ccd284ebdfba155e507c",
      "scheduleAtUTC": "2026-05-28T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-28 13:05 WIB",
      "charCount": 72,
      "text": "Checklist sebelum event: rundown, lighting, spot crowd, dan momen wajib."
    },
    {
      "n": 29,
      "scheduleId": "69e5ccd384ebdfba155e5080",
      "scheduleAtUTC": "2026-05-29T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-29 13:05 WIB",
      "charCount": 70,
      "text": "Sesudah event: jangan simpen file doang. Pecah jadi konten per segmen."
    },
    {
      "n": 30,
      "scheduleId": "69e5ccd384ebdfba155e5086",
      "scheduleAtUTC": "2026-05-30T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-30 13:05 WIB",
      "charCount": 68,
      "text": "Kalau kamu mau hasil yang konsisten, prosesnya juga harus konsisten."
    },
    {
      "n": 31,
      "scheduleId": "69e5ccd384ebdfba155e508d",
      "scheduleAtUTC": "2026-05-31T06:05:00.000Z",
      "scheduleAtWIB": "2026-05-31 13:05 WIB",
      "charCount": 88,
      "text": "Kalau mau, gue bisa bantu audit dokumentasi event kamu: mana yang kuat, mana yang lemah."
    }
  ]
}
